#!/bin/sh
set -eu
repo=$(git rev-parse --show-toplevel)
config=$(git config --get privacy.configFile || true)
if [ -n "$config" ]; then
    case "$config" in
        /*) ;;
        *) config="$repo/$config" ;;
    esac
fi
if [ -z "$config" ] || [ ! -f "$config" ] || [ ! -r "$config" ]; then
    printf '%s\n' 'Privacy check requires a readable private JSON config outside the repository.' >&2
    exit 2
fi
exec python3 "$repo/tools/privacy_check.py" --repo "$repo" --config "$config" --message-file "$1"
